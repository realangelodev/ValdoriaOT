{# Valdoria: the guild list as one clean list, with one clear way to found a guild. #}
<div class="v-guilds-head">
	<div>
		<h2 class="v-guilds-title">{{ guilds|length }} {{ guilds|length == 1 ? 'guild' : 'guilds' }}</h2>
		<p class="v-guilds-sub">Band together with other adventurers. Every guild has its own ranks, members and story.</p>
	</div>
	{% if logged %}
		<a class="btn btn-gold" href="{{ getLink('guilds') }}?action=create">Found a guild</a>
	{% else %}
		<a class="btn btn-gold" href="{{ getLink('account/manage') }}?redirect={{ getLink('guilds')|url_encode }}">Log in to found a guild</a>
	{% endif %}
</div>

{% if guilds|length > 0 %}
<ul class="v-guilds">
	{% for guild in guilds %}
	{% set noText = guild.description is empty or guild.description == setting('core.guild_description_default') %}
	<li class="v-guild">
		<a class="v-guild-main" href="{{ guild.link }}">
			<img class="v-guild-logo" src="{{ constant('GUILD_IMAGES_DIR') }}{{ guild.logo }}" alt="" width="48" height="48" loading="lazy">
			<span class="v-guild-text">
				<strong>{{ guild.name }}</strong>
				<small{% if noText %} class="is-empty"{% endif %}>{{ noText ? 'No description yet.' : guild.description|striptags }}</small>
			</span>
			<svg class="v-guild-go" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
		</a>
		{% if isAdmin %}<a class="v-guild-del" href="{{ getLink('guilds') }}?action=delete_by_admin&guild={{ guild.name|url_encode }}" title="Admin: delete {{ guild.name }}">Delete</a>{% endif %}
	</li>
	{% endfor %}
</ul>
{% else %}
<div class="v-empty-card">
	<strong>No guilds yet</strong>
	<span>{% if logged %}Be the first to found one and lead the way.{% else %}Log in and be the first to found one.{% endif %}</span>
</div>
{% endif %}

{% if logged %}
<div class="v-tip">
	<span>Stuck joining or founding a guild?</span>
	<div class="v-tip-actions">
		<a class="btn btn-sm" href="{{ getLink('guilds') }}?action=cleanup_players">Fix guild memberships</a>
		<a class="btn btn-sm" href="{{ getLink('guilds') }}?action=cleanup_guilds">Remove empty guilds</a>
	</div>
</div>
{% endif %}
