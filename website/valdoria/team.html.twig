{# Valdoria: the staff, one card per member, highest rank first. #}
<p class="v-intro">These are the people who keep the realm running. Need help in game? Send one of them a message.</p>
{% set any = false %}
<div class="v-team">
{% for group in groupmember|reverse %}
	{% for member in group.members|reverse %}
		{% set any = true %}
		<article class="v-member">
			{% if setting('core.team_outfit') and member.outfit %}<img class="v-member-outfit" src="{{ member.outfit }}" alt="" loading="lazy" onerror="this.remove()"/>{% endif %}
			<div>
				<span class="v-member-rank">{{ group.group_name|capitalize }}</span>
				<span class="v-member-name">{% if setting('core.account_country') %}{{ member.flag_image|raw }} {% endif %}{{ member.link|raw }}</span>
				{% if setting('core.team_status') %}<span class="v-member-status {{ member.status ? 'is-on' : 'is-off' }}">{{ member.status ? 'Online' : 'Offline' }}</span>{% endif %}
				{% if setting('core.team_lastlogin') %}<span class="v-sub">Last login: {{ member.last_login }}</span>{% endif %}
			</div>
		</article>
	{% endfor %}
{% endfor %}
</div>
{% if not any %}<p class="v-empty">No staff members yet.</p>{% endif %}
