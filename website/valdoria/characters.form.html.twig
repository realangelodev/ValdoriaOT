{# Valdoria: character search as one clean bar. #}
<form class="v-search" action="{{ getLink('characters') }}" method="post">
	<label class="v-sr" for="v-char-search">Character name</label>
	<input id="v-char-search" type="text" name="name" value="" maxlength="29" placeholder="Search a character by name" autocomplete="off"/>
	<button type="submit" class="btn btn-gold">Search</button>
</form>
