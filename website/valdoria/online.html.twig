{# Valdoria: who is online, as status tiles and one sortable table. #}
{% set onlineCount = players|length %}
{% macro sortLink(label, key, order) %}
	{% set asc = order == key ~ '_asc' %}
	{% set desc = order == key ~ '_desc' %}
	<a class="v-sort{{ asc or desc ? ' is-on' : '' }}" href="{{ getLink('online') }}?order={{ key }}_{{ asc ? 'desc' : 'asc' }}">{{ label }}{% if asc %} ↑{% elseif desc %} ↓{% endif %}</a>
{% endmacro %}

<div class="v-summary">
	<span class="state {{ status.online ? 'is-on' : 'is-off' }}"><span class="dot {{ status.online ? 'dot-on' : 'dot-off' }}"></span>{{ status.online ? 'Online' : 'Offline' }}</span>
	<span class="v-summary-count"><strong>{{ onlineCount }}</strong> {{ onlineCount == 1 ? 'player' : 'players' }} online</span>
	{% if setting('core.online_record') and record|length > 0 %}<span class="v-summary-extra">Record: {{ record|striptags|split(' ')|first }}</span>{% endif %}
</div>
{% if setting('core.online_vocations') and onlineCount > 0 %}
<ul class="v-chips">
	{% for i in 1..config.vocations_amount %}<li>{{ config.vocations[i] }}s <strong>{{ vocations[i] ?? 0 }}</strong></li>{% endfor %}
</ul>
{% endif %}

<div class="v-table-wrap">
<table class="v-table">
	<thead>
		<tr>
			{% if setting('core.online_outfit') and onlineCount > 0 %}<th class="v-outfit"><span class="v-sr">Outfit</span></th>{% endif %}
			<th>{{ _self.sortLink('Name', 'name', order) }}</th>
			<th class="v-num">{{ _self.sortLink('Level', 'level', order) }}</th>
			<th>{{ _self.sortLink('Vocation', 'vocation', order) }}</th>
		</tr>
	</thead>
	<tbody>
	{% for player in players %}
		<tr>
			{% if setting('core.online_outfit') %}<td class="v-outfit"><img src="{{ player.outfit }}" alt="" loading="lazy" onerror="this.remove()"/></td>{% endif %}
			<td class="v-name">{% if setting('core.account_country') %}{{ player.country_image|raw }} {% endif %}{{ player.name|raw }} {{ player.skull|raw }}</td>
			<td class="v-num v-strong">{{ player.level }}</td>
			<td>{{ player.vocation }}</td>
		</tr>
	{% else %}
		<tr><td colspan="4" class="v-empty">{{ status.online ? 'Nobody is online right now. Be the first!' : 'The realm is offline right now. Check back soon.' }}</td></tr>
	{% endfor %}
	</tbody>
</table>
</div>
<p class="v-note">{% set onlineTTL = setting('core.online_cache_ttl') %}{% if onlineTTL > 0 and cache.enabled() %}The list refreshes every {{ onlineTTL > 1 ? onlineTTL ~ ' minutes' : 'minute' }}.{% endif %}</p>
