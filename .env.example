# Copy this file to ".env" (setup.bat does it for you) and change the admin details before the first start.
# The admin account is created once, when the website is first set up.

# Your admin login for the website and the game.
ADMIN_ACCOUNT=hollowadmin
# 8 to 29 characters, with at least one letter and one number.
ADMIN_PASSWORD=ChangeMe123
ADMIN_EMAIL=admin@example.com
# Your Game Master character's name.
ADMIN_CHARACTER=Angelo

# Where people open the website. Use http://localhost while you test on this PC.
SITE_URL=http://localhost
# Time zone for server saves, logs and the website, e.g. Europe/Lisbon or America/New_York.
TZ=UTC

# The game client folder to offer on the website's Downloads page (packed into a zip by setup.bat).
# Leave empty to use otclientv8-master on your Desktop, if it is there.
CLIENT_FOLDER=

# Your Discord invite link, for the Discord button at the bottom of the website (e.g. https://discord.gg/abc123).
DISCORD_URL=
