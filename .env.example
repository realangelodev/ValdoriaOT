# Copy this file to ".env" (start.bat does it for you) and change the admin details before the first start.
# The admin account is created once, the first time the website starts.

# Your admin login for the website and the game.
ADMIN_ACCOUNT=hollowadmin
# 8 to 29 characters, with at least one letter and one number.
ADMIN_PASSWORD=ChangeMe123
ADMIN_EMAIL=admin@example.com
# Your Game Master character's name.
ADMIN_CHARACTER=Angelo

# Where people open the website. Use http://localhost while you test on this PC.
SITE_URL=http://localhost
# Change this if something else on your PC already uses port 80 (then visit http://localhost:8080).
WEB_PORT=80

# Time zone for server saves, logs and the website, e.g. Europe/Lisbon or America/New_York.
TZ=UTC
